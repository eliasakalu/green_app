{
  "expo": {
    "name": "Zefinote Selam Mezmur",
    "slug": "eliasapp",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A255C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elias.musicapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A255C"
      },
      "package": "com.elias.musicapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-av",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "2003c2c5-1955-4662-89bb-c49a9b3a5b28"
      }
    },
    "owner": "eliasz21"
  }
}
